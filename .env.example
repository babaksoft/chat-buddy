# OpenAI is disabled unless this explicit Chat-specific opt-in is true.
CHAT_OPENAI_ENABLED=false
CHAT_OPENAI_API_KEY=

# Optional, networked, and billable test opt-in.
CHAT_OPENAI_SMOKE_TEST=false

# Configuration for the Characters Ollama provider and independently selected models.
CHARACTERS_OLLAMA_ENDPOINT_URL=http://localhost:11434
CHARACTERS_RESPONSE_MODEL=gpt-oss:20b-cloud
CHARACTERS_SUMMARY_MODEL=gpt-oss:20b-cloud
CHARACTERS_MEMORY_EXTRACTION_MODEL=gpt-oss:20b-cloud
CHARACTERS_CONTEXT_TOKENS=8192
CHARACTERS_OUTPUT_TOKENS=1024
